% Como citar o REDGIM.
%
% Duas entradas, e qual usar depende do que entrou no seu trabalho:
%   - rosa2022redgim  -> o MÉTODO, publicado e validado contra espectrofotometria;
%   - redgim-software -> o APLICATIVO em si. Troque `version` pela versão que você usou:
%                        ela aparece em "Sobre o REDGIM", na tela inicial.
%
% https://labqui.github.io/redgim-docs/how-to-cite

@article{rosa2022redgim,
  author  = {Rosa, Thalles R. and Siqueira, Bruno M. M. and Costa, Rayana A. and
             dos Reis, Jadson Z. and Pacheco, Wagner L. S. and de Moura, Paulo R. G. and
             Rom{\~a}o, Wanderson and Filgueiras, Paulo R.},
  title   = {{REDGIM} como aplicativo de smartphone para aplica{\c c}{\~o}es
             quimiom{\'e}tricas por meio de an{\'a}lise de imagens: um uso em {PLS}},
  journal = {Qu{\'i}mica Nova},
  year    = {2022},
  volume  = {45},
  number  = {5},
  pages   = {550--559},
  url     = {http://quimicanova.sbq.org.br/detalhe_artigo.asp?id=9415}
}

@software{redgim-software,
  author  = {Rosa, Thalles Ramon},
  title   = {{REDGIM}: processamento inteligente de imagens digitais para a
             qu{\'i}mica anal{\'i}tica},
  version = {x.y.z},
  note    = {Registrado no INPI sob o processo BR 51 2018 001100-4},
  url     = {https://labqui.github.io/redgim-docs}
}
